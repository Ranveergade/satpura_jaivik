# Django / PostgreSQL (never commit real secrets)
DB_NAME=satpura_jaivik
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Production hosts can set DATABASE_URL instead of the DB_* values above.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required in production; keep DEBUG=false there.
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated browser origins allowed to submit CSRF-protected requests.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Login OTP mail. Leave EMAIL_HOST empty locally to print OTPs in the terminal.
# In production use an SMTP provider that allows port 587.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.com

# First accounts for a hosted deployment. The backend build command runs
# `manage.py bootstrap_users`, which creates these once and skips any existing
# username, so a redeploy never resets a password. Leave blank locally.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_SUPERVISOR_USERNAME=
# BOOTSTRAP_SUPERVISOR_EMAIL=
# BOOTSTRAP_SUPERVISOR_PASSWORD=
# BOOTSTRAP_FARMER_USERNAME=
# BOOTSTRAP_FARMER_EMAIL=
# BOOTSTRAP_FARMER_PASSWORD=

# Frontend (copy into frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=/backend
DJANGO_ORIGIN=http://127.0.0.1:8000
